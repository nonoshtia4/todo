<%= form_for(@task) do |f| %>
  <% if @task.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :content, '内容' %>
    <%= f.text_area :content, class: 'form-control', rows: 3, placeholder: 'タスクの内容を入力' %>
  </div>

  <div class="form-group">
    <%= f.label :status, 'ステータス' %>
    <%= f.select :status,
      [['未着手', 'todo'], ['進行中', 'doing'], ['完了', 'done']],
      {},
      class: 'form-control' %>
  </div>

  <div class="actions">
    <%= f.submit '保存', class: 'btn btn-primary' %>
  </div>
<% end %>
