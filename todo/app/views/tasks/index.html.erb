<h1 class="mb-4">タスク一覧</h1>

<% if @tasks.empty? %>
  <p class="text-muted">タスクがありません。新しいタスクを追加してください。</p>
<% else %>
  <table class="table table-hover">
    <thead class="thead-dark">
      <tr>
        <th>内容</th>
        <th>ステータス</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.content %></td>
          <td>
            <% badge_class = { 'todo' => 'secondary', 'doing' => 'primary', 'done' => 'success' }[task.status] %>
            <span class="badge badge-<%= badge_class %>">
              <%= { 'todo' => '未着手', 'doing' => '進行中', 'done' => '完了' }[task.status] %>
            </span>
          </td>
          <td class="text-right">
            <%= link_to '詳細', task, class: 'btn btn-sm btn-outline-secondary mr-1' %>
            <%= link_to '編集', edit_task_path(task), class: 'btn btn-sm btn-outline-primary mr-1' %>
            <%= link_to '削除', task, method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-sm btn-outline-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
