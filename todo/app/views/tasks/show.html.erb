<h1 class="mb-4">タスク詳細</h1>

<div class="card">
  <div class="card-body">
    <dl class="row">
      <dt class="col-sm-2">内容</dt>
      <dd class="col-sm-10"><%= @task.content %></dd>

      <dt class="col-sm-2">ステータス</dt>
      <dd class="col-sm-10">
        <% badge_class = { 'todo' => 'secondary', 'doing' => 'primary', 'done' => 'success' }[@task.status] %>
        <span class="badge badge-<%= badge_class %>">
          <%= { 'todo' => '未着手', 'doing' => '進行中', 'done' => '完了' }[@task.status] %>
        </span>
      </dd>
    </dl>
  </div>
</div>

<div class="mt-3">
  <%= link_to '編集', edit_task_path(@task), class: 'btn btn-primary mr-1' %>
  <%= link_to '一覧に戻る', tasks_path, class: 'btn btn-outline-secondary' %>
</div>
